# ==============================================================================
# SENSORIUM NEURAL CORE - ENCLAVE IA & SIGNATAIRE CRYPTOGRAPHIQUE HSM
# Python 3.12 Slim Hardened Image (DORA Art. 12 & FIPS 140-3 Compliant)
# ==============================================================================
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENV=PRODUCTION \
    FLASK_RUN_PORT=5000

WORKDIR /app

# Installation des dépendances minimales et création de l'utilisateur non-root
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 10002 -s /bin/bash -m sensorium_ai

# Copie des scripts du Neural Core et de l'enclave
COPY neural_core_engine.py hsm_enclave_signer.py ./
COPY topology.json ./

# Définition des permissions strictes
RUN chown -R sensorium_ai:sensorium_ai /app

USER 10002:10002

EXPOSE 5000

# Exécution du signataire ou daemon d'inférence
CMD ["python", "hsm_enclave_signer.py", "rack_b"]
