# Configuration d'exemple (.env.example)
# Copier ce fichier vers .env.local ou .env.production selon le déploiement
# =============================================================================

PORT=3000

# Base API & WebSocket
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=http://localhost:3000

# Sécurité & Autorisation CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://sensorium.local:3000
# Secrets obligatoires en production (générer via : openssl rand -hex 64)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
ENCRYPTION_KEY=
EDGE_SECRET=
UEM_AGENT_API_KEY=
FIREBASE_WEB_API_KEY=
COOKIE_SECURE=false

# Redis (Requis en production pour RTR JWT distribué et cache)
REDIS_URL=

# Intégrations Tiers
VITE_PAYPAL_CLIENT_ID=sb
VITE_GOOGLE_MAPS_API_KEY=

# MinIO Sovereign S3 Object Storage (obligatoire)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_DEFAULT_BUCKET=sensorium-vault
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000
