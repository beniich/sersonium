# Configuration d'exemple (.env.example)
# Copier ce fichier vers .env.local ou .env.production selon le déploiement
# =============================================================================

PORT=3000

# Base API & WebSocket
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=http://localhost:3000

# Sécurité & Autorisation CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://sensorium.local:3000
# Secrets obligatoires en production (générer via : openssl rand -base64 64)
JWT_SECRET=
SESSION_SECRET=
COOKIE_SECURE=false

# Intégrations Tiers
VITE_PAYPAL_CLIENT_ID=sb
VITE_GOOGLE_MAPS_API_KEY=
