# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT Secret Keys for Authentication & Session Management
JWT_ACCESS_SECRET="your_jwt_access_secret_key"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key"

# Database connection URL (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Kafka Event Streaming Configuration (Optional)
# Leave KAFKA_BROKERS empty to run in MOCK mode (events are logged to console instead of streamed).
# To enable real Kafka integration (e.g., Upstash Kafka or Confluent Cloud):
# KAFKA_BROKERS="broker1.kafka.example.com:9092,broker2.kafka.example.com:9092"
# KAFKA_USERNAME="your_sasl_username"
# KAFKA_PASSWORD="your_sasl_password"
# KAFKA_CLIENT_ID="jeton-edge-backend"

# Google Maps Platform API Key (Optional for GeoAssetHeatMap satellite and street view)
# Mint a key in Google Cloud Console or via https://mapsplatform.google.com/maps-demo-key
VITE_GOOGLE_MAPS_API_KEY=

# PayPal REST API Configuration
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_MODE="sandbox" # or "live"
PAYPAL_CURRENCY="EUR"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"
PAYPAL_WEBHOOK_URL="https://your-domain.com/api/v1/paypal/webhook"
