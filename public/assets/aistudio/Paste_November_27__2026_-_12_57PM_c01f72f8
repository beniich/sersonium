const positionClasses: Record<Group['position'], string> = {
  'top-left': 'top-6 left-6',
  'top-right': 'top-6 right-6',
  'middle-left': 'top-1/2 -translate-y-1/2 left-6',
  'middle-right': 'top-1/2 -translate-y-1/2 right-6',
  'bottom-left': 'bottom-28 left-6',
  'bottom-right': 'bottom-28 right-6',
}

const statusColors: Record<AgentStatus, string> = {
  active: 'bg-emerald-500',
  idle: 'bg-gray-400',
  running: 'bg-orange-500',
  success: 'bg-emerald-500',
  error: 'bg-red-500',
}

async function runAgentAPI(agentId: string, agentName: string) {
  const delay = 1600 + Math.random() * 1400
  return new Promise<{ success: boolean; duration: number; output?: string; error?: string }>((resolve) => {
    setTimeout(() => {
      const isSuccess = Math.random() > 0.12
      if (isSuccess) {
        resolve({
          success: true,
          duration: Math.round(delay),
          output: `Agent "${agentName}" executed successfully.`,
        })
      } else {
        resolve({
          success: false,
          duration: Math.round(delay),
          error: 'Upstream timeout or rate limit',
        })
      }
    }, delay)
  })
}

export default function AgentOrbit() {
  const [groups, setGroups] = useState(groupsData)
  const [selectedAgent, setSelectedAgent] = useState<(Agent & { groupTitle: string }) | null>(null)
  const [isRunning, setIsRunning] = useState(false)
  const [progress, setProgress] = useState(0)
  const [runLogs, setRunLogs] = useState<string[]>([])
  const [lastResult, setLastResult] = useState<'success' | 'error' | null>(null)

  // Command bar state
  const [command, setCommand] = useState('')
  const [commandHistory, setCommandHistory] = useState<string[]>([])
  const [isProcessingCommand, setIsProcessingCommand] = useState(false)
  const [commandFeedback, setCommandFeedback] = useState<string | null>(null)
  const inputRef = useRef<HTMLInputElement>(null)

  const updateAgentStatus = (agentId: string, newStatus: AgentStatus) => {
    setGroups((prev) =>
      prev.map((group) => ({
        ...group,
        agents: group.agents.map((a) => (a.id === agentId ? { ...a, status: newStatus } : a)),
      }))
    )
    if (selectedAgent?.id === agentId) {
      setSelectedAgent((prev) => (prev ? { ...prev, status: newStatus } : null))
    }
  }

  const findAgentByName = (name: string) => {
    const lower = name.toLowerCase()
    for (const group of groups) {
      const agent = group.agents.find((a) => a.name.toLowerCase().includes(lower))
      if (agent) return { agent, groupTitle: group.title }
    }
    return null
  }

  // Simple command parser
  const processCommand = async (cmd: string) => {
    const lower = cmd.toLowerCase().trim()
    setIsProcessingCommand(true)
    setCommandFeedback(null)

    // Add to history
    setCommandHistory((prev) => [cmd, ...prev].slice(0, 20))

    try {
      // Reset all
      if (lower.includes('reset all') || lower.includes('reset tous')) {
        setGroups((prev) =>
          prev.map((g) => ({
            ...g,
            agents: g.agents.map((a) => ({ ...a, status: 'idle' as AgentStatus })),
          }))
        )
        setCommandFeedback('Tous les agents ont été réinitialisés.')
        return
      }

      // Run specific agent
      if (lower.startsWith('lance ') || lower.startsWith('run ') || lower.startsWith('exécute ')) {
        const name = cmd.replace(/^(lance|run|exécute)\s+/i, '').trim()
        const found = findAgentByName(name)
        if (found) {
          setSelectedAgent({ ...found.agent, groupTitle: found.groupTitle })
          setCommandFeedback(`Lancement de ${found.agent.name}...`)
          // Trigger run
          setTimeout(() => runAgentById(found.agent.id, found.agent.name), 300)
        } else {
          setCommandFeedback(`Agent "${name}" introuvable.`)
        }
        return
      }

      // Help
      if (lower === 'help' || lower === 'aide') {
        setCommandFeedback('Commandes : « lance Trend Scout », « reset all », « status »')
        return
      }

      // Status
      if (lower === 'status' || lower.includes('en cours')) {
        const running = groups.flatMap((g) => g.agents).filter((a) => a.status === 'running')
        setCommandFeedback(
          running.length > 0
            ? `Agents en cours : ${running.map((a) => a.name).join(', ')}`
            : 'Aucun agent en cours d’exécution.'
        )
        return
      }

      setCommandFeedback(`Ordre reçu : "${cmd}" (traitement simulé)`)
    } finally {
      setTimeout(() => setIsProcessingCommand(false), 600)
    }
  }

  const runAgentById = async (agentId: string, agentName: string) => {
    setIsRunning(true)
    setProgress(0)
    setLastResult(null)
    setRunLogs([])
    updateAgentStatus(agentId, 'running')

    const progressInterval = setInterval(() => {
      setProgress((prev) => (prev >= 90 ? prev : prev + Math.random() * 8))
    }, 200)

    try {
      const result = await runAgentAPI(agentId, agentName)
      clearInterval(progressInterval)
      setProgress(100)
      if (result.success) {
        updateAgentStatus(agentId, 'success')
        setLastResult('success')
        setRunLogs((prev) => [...prev, `✅ ${result.output}`])
      } else {
        updateAgentStatus(agentId, 'error')
        setLastResult('error')
        setRunLogs((prev) => [...prev, `❌ ${result.error}`])
      }
    } finally {
      setIsRunning(false)
    }
  }

  const handleSubmitCommand = (e: React.FormEvent) => {
    e.preventDefault()
    if (!command.trim() || isProcessingCommand) return
    processCommand(command)
    setCommand('')
  }

  const handleAgentClick = (agent: Agent, groupTitle: string) => {
    setSelectedAgent({ ...agent, groupTitle })
    setIsRunning(false)
    setProgress(0)
    setRunLogs([])
    setLastResult(null)
  }

  const closePanel = () => {
    setSelectedAgent(null)
    setIsRunning(false)
    setProgress(0)
    setRunLogs([])
    setLastResult(null)
  }

  const runAgent = async () => {
    if (!selectedAgent || isRunning) return
    await runAgentById(selectedAgent.id, selectedAgent.name)
  }

  const resetAgent = () => {
    if (!selectedAgent) return
    setIsRunning(false)
    setProgress(0)
    setRunLogs([])
    setLastResult(null)
    updateAgentStatus(selectedAgent.id, 'idle')
  }

  return (
    <div className="relative w-full h-[860px] bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-900 dark:to-gray-950 rounded-3xl overflow-hidden border border-gray-200 dark:border-gray-800">
      {/* SVG Connections */}
      <svg className="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1000 820" fill="none">
        <motion.path
          d="M500 60 C500 160 500 260 500 360 C500 460 500 560 500 700"
          stroke="url(#lineGradient)"
          strokeWidth="2.5"
          strokeLinecap="round"
          initial={{ pathLength: 0, opacity: 0 }}
          animate={{ pathLength: 1, opacity: 0.7 }}
          transition={{ duration: 1.6 }}
        />
        {['M180 180 H420', 'M580 180 H820', 'M180 390 H420', 'M580 390 H820', 'M180 600 H420', 'M580 600 H820'].map((d, i) => (
          <motion.path key={i} d={d} stroke="#f97316" strokeWidth="1.5"
            initial={{ pathLength: 0, opacity: 0 }}
            animate={{ pathLength: 1, opacity: 0.4 }}
            transition={{ duration: 1.2, delay: 0.3 + i * 0.08 }}
          />
        ))}
        {[180, 390, 600].map((y, i) => (
          <motion.circle key={y} cx="500" cy={y} r="5" fill="#f97316"
            animate={{ scale: [1, 1.6, 1], opacity: [0.8, 0.3, 0.8] }}
            transition={{ duration: 2.2, repeat: Infinity, delay: i * 0.35 }}
          />
        ))}
        <defs>
          <linearGradient id="lineGradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stopColor="#f97316" stopOpacity="0.3" />
            <stop offset="50%" stopColor="#f97316" stopOpacity="1" />
            <stop offset="100%" stopColor="#f97316" stopOpacity="0.3" />
          </linearGradient>
        </defs>
      </svg>

      {/* Center Node */}
      <motion.div
        className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 flex flex-col items-center"
        initial={{ opacity: 0, scale: 0.6 }}
        animate={{ opacity: 1, scale: 1 }}
      >
        <div className="mb-3 px-4 py-1.5 bg-black dark:bg-white text-white dark:text-black text-xs font-medium rounded-full shadow-lg">
          You
        </div>
        <motion.div
          className="w-20 h-20 rounded-2xl bg-black dark:bg-gray-800 flex items-center justify-center shadow-2xl ring-4 ring-orange-400/40"
          whileHover={{ scale: 1.1, rotate: 6 }}
        >
          <svg viewBox="0 0 24 24" className="w-10 h-10 text-orange-400" fill="currentColor">
            <path d="M12 2L14.5 9H22L16 13.5L18.5 21L12 16.5L5.5 21L8 13.5L2 9H9.5L12 2Z" />
          </svg>
        </motion.div>
        <div className="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs font-medium text-gray-500 dark:text-gray-400">
          Claude Code
        </div>
      </motion.div>

      {/* Agent Cards */}
      {groups.map((group, groupIndex) => (
        <motion.div
          key={group.id}
          initial={{ opacity: 0, scale: 0.85, y: 30 }}
          animate={{ opacity: 1, scale: 1, y: 0 }}
          transition={{ delay: 0.15 + groupIndex * 0.08 }}
          whileHover={{ scale: 1.03, y: -6 }}
          className={`absolute w-64 bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700 p-4 ${positionClasses[group.position]}`}
        >
          <div className="flex items-center justify-between mb-3">
            <h3 className="font-semibold text-gray-800 dark:text-gray-100 text-sm">{group.title}</h3>
            <span className="text-xs text-gray-400">{group.count} agents</span>
          </div>
          <ul className="space-y-1.5">
            {group.agents.map((agent) => (
              <motion.li
                key={agent.id}
                onClick={() => handleAgentClick(agent, group.title)}
                whileHover={{ x: 4 }}
                className={`flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-sm cursor-pointer ${
                  agent.highlighted
                    ? 'bg-orange-50 dark:bg-orange-500/15 text-orange-700 dark:text-orange-300 font-medium border border-orange-100 dark:border-orange-500/30'
                    : 'text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700/50'
                }`}
              >
                <span>{agent.icon}</span>
                <span className="truncate flex-1">{agent.name}</span>
                {agent.status === 'running' && (
                  <motion.span className="w-1.5 h-1.5 rounded-full bg-orange-400"
                    animate={{ scale: [1, 1.5, 1] }}
                    transition={{ repeat: Infinity, duration: 1.2 }}
                  />
                )}
                {agent.status === 'success' && <span className="text-emerald-500 text-xs">✓</span>}
                {agent.status === 'error' && <span className="text-red-500 text-xs">✕</span>}
              </motion.li>
            ))}
          </ul>
        </motion.div>
      ))}

      {/* Side Panel */}
      <AnimatePresence>
        {selectedAgent && (
          <>
            <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}
              onClick={closePanel} className="absolute inset-0 bg-black/20 dark:bg-black/40 z-40" />
            <motion.div
              initial={{ x: '100%' }} animate={{ x: 0 }} exit={{ x: '100%' }}
              transition={{ type: 'spring', stiffness: 260, damping: 28 }}
              className="absolute top-0 right-0 h-full w-[380px] bg-white dark:bg-gray-900 shadow-2xl z-50 border-l border-gray-200 dark:border-gray-700 flex flex-col"
            >
              <div className="flex items-center justify-between p-5 border-b border-gray-100 dark:border-gray-800">
                <div>
                  <p className="text-xs text-gray-400 mb-0.5">{selectedAgent.groupTitle} · {selectedAgent.platform}</p>
                  <h2 className="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                    <span>{selectedAgent.icon}</span>
                    {selectedAgent.name}
                  </h2>
                </div>
                <button onClick={closePanel} className="w-8 h-8 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center text-gray-500">✕</button>
              </div>

              <div className="flex-1 p-5 overflow-y-auto">
                <p className="text-sm text-gray-600 dark:text-gray-300 mb-6">{selectedAgent.description}</p>

                <div className="flex items-center justify-between p-3 rounded-xl bg-gray-50 dark:bg-gray-800 mb-5">
                  <span className="text-sm text-gray-500">Status</span>
                  <div className="flex items-center gap-2">
                    <span className={`w-2 h-2 rounded-full ${statusColors[selectedAgent.status || 'idle']}`} />
                    <span className="text-sm font-medium capitalize">{selectedAgent.status || 'idle'}</span>
                  </div>
                </div>

                {(isRunning || progress > 0) && (
                  <div className="mb-5">
                    <div className="flex justify-between text-xs text-gray-500 mb-1.5">
                      <span>{isRunning ? 'Calling API...' : lastResult === 'success' ? 'Completed' : 'Failed'}</span>
                      <span>{Math.round(progress)}%</span>
                    </div>
                    <div className="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                      <motion.div
                        className={`h-full ${lastResult === 'error' ? 'bg-red-500' : 'bg-gradient-to-r from-orange-500 to-orange-400'}`}
                        initial={{ width: 0 }}
                        animate={{ width: `${progress}%` }}
                      />
                    </div>
                  </div>
                )}

                <div className="grid grid-cols-2 gap-3 mb-6">
                  <button onClick={runAgent} disabled={isRunning}
                    className={`py-2.5 px-4 rounded-xl text-white text-sm font-medium flex items-center justify-center gap-2 ${
                      isRunning ? 'bg-orange-400 cursor-not-allowed' : 'bg-orange-500 hover:bg-orange-600'
                    }`}>
                    {isRunning ? 'Running...' : '▶ Run Agent'}
                  </button>
                  <button onClick={resetAgent} disabled={isRunning}
                    className="py-2.5 px-4 rounded-xl bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-sm font-medium disabled:opacity-50">
                    Reset
                  </button>
                </div>

                {runLogs.length > 0 && (
                  <div className="bg-gray-50 dark:bg-gray-800/80 rounded-xl p-3 font-mono text-xs space-y-1">
                    {runLogs.map((log, i) => (
                      <div key={i} className={log.includes('✅') ? 'text-emerald-600' : log.includes('❌') ? 'text-red-500' : ''}>
                        {log}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </motion.div>
          </>
        )}
      </AnimatePresence>

      {/* ===================== COMMAND BAR ===================== */}
      <div className="absolute bottom-0 left-0 right-0 z-30 p-4">
        <div className="max-w-3xl mx-auto">
          {/* Feedback */}
          <AnimatePresence>
            {commandFeedback && (
              <motion.div
                initial={{ opacity: 0, y: 8 }}
                animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0 }}
                className="mb-2 text-center text-sm text-orange-600 dark:text-orange-400"
              >
                {commandFeedback}
              </motion.div>
            )}
          </AnimatePresence>

          <form onSubmit={handleSubmitCommand}>
            <div className="flex items-center gap-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-lg px-4 py-3">
              <span className="text-gray-400 text-lg">+</span>
              
              <input
                ref={inputRef}
                type="text"
                value={command}
                onChange={(e) => setCommand(e.target.value)}
                placeholder="Injecter un ordre... (ex: lance Trend Scout, reset all, status)"
                className="flex-1 bg-transparent text-sm text-gray-800 dark:text-gray-200 placeholder-gray-400 focus:outline-none"
                disabled={isProcessingCommand}
              />

              <div className="flex items-center gap-2">
                <span className="text-xs text-gray-400 hidden sm:block">Max</span>
                <button
                  type="submit"
                  disabled={!command.trim() || isProcessingCommand}
                  className="w-9 h-9 rounded-full bg-orange-500 hover:bg-orange-600 disabled:bg-gray-300 dark:disabled:bg-gray-600 flex items-center justify-center text-white transition-colors"
                >
                  {isProcessingCommand ? (
                    <motion.span
                      className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full"
                      animate={{ rotate: 360 }}
                      transition={{ repeat: Infinity, duration: 0.7, ease: 'linear' }}
                    />
                  ) : (
                    <span className="text-lg">↑</span>
                  )}
                </button>
              </div>
            </div>
          </form>

          {/* Mini history */}
          {commandHistory.length > 0 && (
            <div className="mt-2 flex gap-2 overflow-x-auto pb-1 text-xs text-gray-500 dark:text-gray-400">
              {commandHistory.slice(0, 5).map((h, i) => (
                <button
                  key={i}
                  onClick={() => setCommand(h)}
                  className="px-2.5 py-1 rounded-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 whitespace-nowrap"
                >
                  {h}
                </button>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  )
}
