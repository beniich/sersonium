<!-- Custom styles for dot-matrix density chart and tactile neumorphic touches -->
<style data-purpose="custom-typography-and-effects">
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    body {
      background-color: #0c0e11;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Subtle custom scrollbar */
    ::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    ::-webkit-scrollbar-thumb {
      background: #333538;
      border-radius: 9999px;
    }

    /* Tactile card borders */
    .tactile-surface {
      background: #1e2023;
      border: 1px solid rgba(255, 255, 255, 0.06);
      outline: 1px solid rgba(68, 71, 73, 0.35);
    }

    /* Runs today chart animations & interactions */
    @keyframes dotEnter {
      0% {
        opacity: 0;
        transform: translateY(6px) scale(0.4);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .chart-col {
      position: relative;
      cursor: pointer;
      padding: 4px 3px 0;
      margin: 0 -3px;
      border-radius: 9999px;
      transition: opacity 200ms ease, transform 200ms cubic-bezier(0.22, 1, 0.36, 1), background-color 200ms ease;
    }

    .chart-col .chart-dot {
      animation: dotEnter 420ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
      animation-delay: var(--dot-delay, 0ms);
      transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), background-color 200ms ease, opacity 200ms ease, border-radius 220ms ease, height 220ms ease;
    }

    /* Dim non-hovered columns when chart is hovered */
    .chart-matrix.is-hovering .chart-col:not(.is-active):not(.is-pinned) {
      opacity: 0.32;
    }

    /* Active / hovered column */
    .chart-col.is-active .chart-dot,
    .chart-col.is-pinned .chart-dot {
      transform: scale(1.22);
      background-color: #ffffff;
    }

    /* Pinned selection ring */
    .chart-col.is-pinned::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 5px;
      height: 5px;
      border-radius: 9999px;
      background-color: #ffffff;
      box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.18);
    }

    /* Smooth indicator line movement */
    #chart-peak-indicator {
      transition: left 240ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease;
    }

    /* View mode: Bar view */
    .chart-matrix[data-view="bars"] .chart-col {
      gap: 0px !important;
    }
    .chart-matrix[data-view="bars"] .chart-dot {
      border-radius: 1px;
      width: 6px;
      height: 8px;
    }
    .chart-matrix[data-view="bars"] .chart-dot:first-child {
      border-top-left-radius: 9999px;
      border-top-right-radius: 9999px;
    }
    .chart-matrix[data-view="bars"] .chart-dot:last-child {
      border-bottom-left-radius: 9999px;
      border-bottom-right-radius: 9999px;
    }

    /* View mode: Sparkline / peak-cap view */
    .chart-matrix[data-view="peaks"] .chart-dot:not(:first-child) {
      opacity: 0.16;
      transform: scale(0.65);
    }
    .chart-matrix[data-view="peaks"] .chart-dot:first-child {
      transform: scale(1.25);
      background-color: #ffffff;
    }

    @media (prefers-reduced-motion: reduce) {
      .chart-col,
      .chart-col .chart-dot,
      #chart-peak-indicator {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>
