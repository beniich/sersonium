<script>
    (function () {
      const matrix = document.getElementById('runs-chart-matrix');
      if (matrix) {
        const cols = Array.from(matrix.querySelectorAll('.chart-col'));
        const indicator = document.getElementById('chart-peak-indicator');
        const tooltipPill = document.getElementById('chart-tooltip-pill');
        const viewButtons = Array.from(document.querySelectorAll('[data-view-btn]'));

        let pinnedCol = null;
        const defaultCol = matrix.querySelector('[data-peak="true"]') || cols[10];

        // 1. Staggered entrance animation (bottom-to-top per column)
        cols.forEach((col, colIdx) => {
          const dots = Array.from(col.querySelectorAll('.chart-dot'));
          const total = dots.length;
          dots.forEach((dot, dotIdx) => {
            const fromBottomIdx = total - 1 - dotIdx;
            const delay = colIdx * 20 + fromBottomIdx * 22;
            dot.style.setProperty('--dot-delay', `${delay}ms`);
          });
        });

        // Position indicator & update tooltip text
        function moveIndicatorTo(col, showCount) {
          if (!col || !indicator || !tooltipPill) return;
          const matrixRect = matrix.getBoundingClientRect();
          const colRect = col.getBoundingClientRect();
          const centerLeft = colRect.left - matrixRect.left + colRect.width / 2;

          indicator.style.left = `${centerLeft}px`;
          const time = col.getAttribute('data-time') || '09:25';
          const runs = col.getAttribute('data-runs');
          tooltipPill.textContent = showCount && runs ? `${time} · ${runs} runs` : time;
        }

        // 2. Interactive column hover & 3. Click/pin selection
        cols.forEach((col) => {
          col.addEventListener('mouseenter', () => {
            matrix.classList.add('is-hovering');
            cols.forEach((c) => c.classList.remove('is-active'));
            col.classList.add('is-active');
            moveIndicatorTo(col, true);
          });

          col.addEventListener('click', () => {
            if (pinnedCol === col) {
              col.classList.remove('is-pinned');
              pinnedCol = null;
              moveIndicatorTo(col, true);
            } else {
              cols.forEach((c) => c.classList.remove('is-pinned'));
              col.classList.add('is-pinned');
              pinnedCol = col;
              moveIndicatorTo(col, true);
            }
          });
        });

        matrix.addEventListener('mouseleave', () => {
          matrix.classList.remove('is-hovering');
          cols.forEach((c) => c.classList.remove('is-active'));
          if (pinnedCol) {
            moveIndicatorTo(pinnedCol, true);
          } else {
            moveIndicatorTo(defaultCol, false);
          }
        });

        // 4. Chart view toggle buttons
        viewButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const targetView = btn.getAttribute('data-view-btn');
            matrix.setAttribute('data-view', targetView);

            viewButtons.forEach((b) => {
              b.classList.remove('bg-[#333538]', 'shadow-xs', 'text-white');
              b.classList.add('text-subtle');
            });
            btn.classList.add('bg-[#333538]', 'shadow-xs', 'text-white');
            btn.classList.remove('text-subtle');
          });
        });
      }

      // Dropdown toggle logic
      const orgTrigger = document.getElementById('org-dropdown-trigger');
      const orgMenu = document.getElementById('org-dropdown-menu');
      const orgChevron = document.getElementById('org-dropdown-chevron');
      const orgWrapper = document.getElementById('org-dropdown-wrapper');

      if (orgTrigger && orgMenu && orgChevron) {
        function toggleDropdown(show) {
          const isOpen = !orgMenu.classList.contains('hidden');
          const shouldOpen = typeof show === 'boolean' ? show : !isOpen;

          if (shouldOpen) {
            orgMenu.classList.remove('hidden');
            orgChevron.classList.add('rotate-180');
            orgTrigger.setAttribute('aria-expanded', 'true');
          } else {
            orgMenu.classList.add('hidden');
            orgChevron.classList.remove('rotate-180');
            orgTrigger.setAttribute('aria-expanded', 'false');
          }
        }

        orgTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleDropdown();
        });

        document.addEventListener('click', (e) => {
          if (orgWrapper && !orgWrapper.contains(e.target)) {
            toggleDropdown(false);
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            toggleDropdown(false);
          }
        });
      }
    })();
  </script>


