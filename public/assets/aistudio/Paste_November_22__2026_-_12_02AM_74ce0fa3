const positionClasses: Record<Group['position'], string> = {
  'top-left': 'top-6 left-6',
  'top-right': 'top-6 right-6',
  'middle-left': 'top-1/2 -translate-y-1/2 left-6',
  'middle-right': 'top-1/2 -translate-y-1/2 right-6',
  'bottom-left': 'bottom-6 left-6',
  'bottom-right': 'bottom-6 right-6',
}

const statusColors: Record<AgentStatus, string> = {
  active: 'bg-emerald-500',
  idle: 'bg-gray-400',
  running: 'bg-orange-500',
  success: 'bg-emerald-500',
  error: 'bg-red-500',
}

// Simulation d'appel API réel
async function runAgentAPI(agentId: string, agentName: string) {
  const delay = 1800 + Math.random() * 1700
  return new Promise<{ success: boolean; duration: number; output?: string; error?: string }>((resolve) => {
    setTimeout(() => {
      const isSuccess = Math.random() > 0.15
      if (isSuccess) {
        resolve({
          success: true,
          duration: Math.round(delay),
          output: `Agent "${agentName}" executed successfully. Generated 3 artifacts and updated 2 data sources.`,
        })
      } else {
        resolve({
          success: false,
          duration: Math.round(delay),
          error: 'Upstream service timeout • Rate limit exceeded on external API',
        })
      }
    }, delay)
  })
}

interface Props {
  isDark?: boolean
}

export default function AgentOrbit({ isDark }: Props) {
  const [groups, setGroups] = useState(groupsData)
  const [selectedAgent, setSelectedAgent] = useState<(Agent & { groupTitle: string }) | null>(null)
  const [isRunning, setIsRunning] = useState(false)
  const [progress, setProgress] = useState(0)
  const [runLogs, setRunLogs] = useState<string[]>([])
  const [lastResult, setLastResult] = useState<'success' | 'error' | null>(null)

  const handleAgentClick = (agent: Agent, groupTitle: string) => {
    setSelectedAgent({ ...agent, groupTitle })
    setIsRunning(false)
    setProgress(0)
    setRunLogs([])
    setLastResult(null)
  }

  const closePanel = () => {
    setSelectedAgent(null)
    setIsRunning(false)
    setProgress(0)
    setRunLogs([])
    setLastResult(null)
  }

  const updateAgentStatus = (agentId: string, newStatus: AgentStatus) => {
    setGroups((prev) =>
      prev.map((group) => ({
        ...group,
        agents: group.agents.map((a) => (a.id === agentId ? { ...a, status: newStatus } : a)),
      }))
    )
    if (selectedAgent?.id === agentId) {
      setSelectedAgent((prev) => (prev ? { ...prev, status: newStatus } : null))
    }
  }

  const addLog = (message: string) => {
    setRunLogs((prev) => [...prev, `[${new Date().toLocaleTimeString()}] ${message}`])
  }

  const runAgent = async () => {
    if (!selectedAgent || isRunning) return

    setIsRunning(true)
    setProgress(0)
    setLastResult(null)
    setRunLogs([])
    updateAgentStatus(selectedAgent.id, 'running')

    addLog(`Calling API → POST /agents/${selectedAgent.id}/run`)
    addLog(`Payload: { agent: "${selectedAgent.name}", mode: "sync" }`)

    const progressInterval = setInterval(() => {
      setProgress((prev) => (prev >= 90 ? prev : prev + Math.random() * 8))
    }, 200)

    try {
      const result = await runAgentAPI(selectedAgent.id, selectedAgent.name)
      clearInterval(progressInterval)
      setProgress(100)

      if (result.success) {
        addLog(`Response 200 OK (${result.duration}ms)`)
        addLog(`✅ ${result.output}`)
        updateAgentStatus(selectedAgent.id, 'success')
        setLastResult('success')
      } else {
        addLog(`Response 500 Error (${result.duration}ms)`)
        addLog(`❌ ${result.error}`)
        updateAgentStatus(selectedAgent.id, 'error')
        setLastResult('error')
      }
    } catch {
      clearInterval(progressInterval)
      setProgress(100)
      addLog(`Network Error: Failed to fetch`)
      updateAgentStatus(selectedAgent.id, 'error')
      setLastResult('error')
    } finally {
      setIsRunning(false)
    }
  }

  const resetAgent = () => {
    if (!selectedAgent) return
    setIsRunning(false)
    setProgress(0)
    setRunLogs([])
    setLastResult(null)
    updateAgentStatus(selectedAgent.id, 'idle')
  }

  return (
    <div className="relative w-full h-[820px] bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-900 dark:to-gray-950 rounded-3xl overflow-hidden border border-gray-200 dark:border-gray-800">
