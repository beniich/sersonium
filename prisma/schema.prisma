datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                     String    @id @default(cuid())
  name                   String
  slug                   String    @unique
  plan                   String    @default("FREE") // FREE, SILVER, PRO
  subscriptionCycle      String?   @default("monthly")
  subscriptionExpiresAt  DateTime?
  paypalSubscriptionId   String?
  subscriptionStatus     String?   @default("inactive") // active, past_due, canceled
  configVersion          Int       @default(1)
  lastConfigUpdate       DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  users       User[]
  emissions   CarbonEmission[]
  assets      InfrastructureAsset[]
  auditLogs   AuditLog[]
  accessPolicies AccessPolicy[]
  invoices    Invoice[]
  telemetries AssetTelemetry[]
  files       FileMetadata[]
  trafficLogs TrafficLog[]
  wafEvents   WafSecurityEvent[]
  strategicObjectives StrategicObjective[]
  kpis        Kpi[]
  certifications Certification[]
  permits     Permit[]
  insurances  Insurance[]
  subscriptions Subscription[]
  licenseKeys LicenseKey[]
  entitlements Entitlement[]
  accessGateLogs AccessGateLog[]
  uemTerminals  UemTerminal[]
  needsSync   Boolean   @default(false)

  @@map("organizations")
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String?  @unique // L'ID unique venant de Google/Firebase
  email       String   @unique
  name        String?
  role        String   @default("operator") // admin, operator, auditor, viewer
  tokens      Int      @default(1000)      // Jeton / Credit system for AI & API usage
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]
  accessPolicies AccessPolicy[]

  @@index([tenantId])
  @@map("users")
}

model CarbonEmission {
  id             String   @id @default(cuid())
  tenantId       String
  title          String
  scope          Int      // 1: Direct, 2: Indirect Energy, 3: Value Chain
  category       String   // e.g. "Data Centers", "Cloud Compute", "Cooling Systems", "Fleet"
  co2EquivalentKg Float   // in kg CO2e
  activityDate   DateTime @default(now())
  source         String   @default("automated_telemetry")
  status         String   @default("verified") // draft, verified, audited
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, scope])
  @@map("carbon_emissions")
}

model InfrastructureAsset {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  location       String
  type           String   // "edge_node", "datacenter", "cooling_unit", "switch"
  status         String   @default("healthy") // "healthy", "warning", "critical", "offline"
  powerUsageKw   Float    @default(0.0)
  pueScore       Float    @default(1.15) // Power Usage Effectiveness
  renewablePct   Float    @default(100.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("infrastructure_assets")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  action      String   // e.g. "CREATE_EMISSION", "UPDATE_ASSET", "SECURITY_ALERT"
  resource    String   // e.g. "CarbonEmission", "InfrastructureAsset"
  resourceId  String?
  details     String?  // JSON string
  oldValue    String?  // JSON string
  newValue    String?  // JSON string
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// --- Sprint 1: Zero Trust ---
model AccessPolicy {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  resourceId  String   // Target resource (e.g. "api/v1/carbon", "datacenter/par-01", "*")
  action      String   // "read", "write", "admin", "*"
  allowed     Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId, resourceId])
  @@map("access_policies")
}

// --- Sprint 1: Manage & Billing (Tokens / Jetons) ---
model Invoice {
  id           String   @id @default(cuid())
  tenantId     String
  amount       Float
  currency     String   @default("EUR")
  status       String   @default("paid") // paid, pending, failed
  description   String
  tokenCredits  Int      @default(0)      // Tokens added with this purchase
  paypalOrderId String?
  payerEmail    String?
  paymentMethod String?  @default("paypal") // paypal_account, card_via_paypal
  subscriptionId String?
  createdAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([subscriptionId])
  @@map("invoices")
}

// --- Sprint 2: Infrastructure (CAFM) Telemetry ---
model AssetTelemetry {
  id             String   @id @default(cuid())
  tenantId       String
  assetId        String
  temperatureC   Float    @default(22.0)
  vibrationMmS   Float    @default(0.5)
  powerKw        Float    @default(50.0)
  pueScore       Float    @default(1.15)
  status         String   @default("nominal") // nominal, warning, critical
  timestamp      DateTime @default(now())

  organization   Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, assetId])
  @@index([tenantId, timestamp])
  @@map("asset_telemetries")
}

// --- Sprint 2: Storage & DB (R2/S3 Buckets) ---
model FileMetadata {
  id          String   @id @default(cuid())
  tenantId    String
  fileName    String
  fileSize    Int
  mimeType    String
  storageKey  String   @unique
  bucket      String   @default("beecarbonat-assets")
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("file_metadata")
}

// --- Sprint 3: Global Traffic & Edge Network ---
model TrafficLog {
  id               String   @id @default(cuid())
  tenantId         String
  nodeId           String   // e.g. "edge-fra-01", "edge-par-02"
  region           String   // e.g. "eu-west-3", "eu-central-1"
  bytesTransferred Float    // in bytes
  latencyMs        Float    // in ms
  statusCode       Int      @default(200)
  timestamp        DateTime @default(now())

  organization     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, timestamp])
  @@index([tenantId, nodeId])
  @@map("traffic_logs")
}

// --- Sprint 3: Security & WAF ---
model WafSecurityEvent {
  id          String   @id @default(cuid())
  tenantId    String
  clientIp    String
  threatType  String   // "rate_limit", "sql_injection", "geo_block", "bot"
  ruleId      String
  action      String   // "block", "challenge", "log"
  blocked     Boolean  @default(true)
  timestamp   DateTime @default(now())

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, timestamp])
  @@map("waf_security_events")
}

// --- Sprint 4: Strategy & OKR (Draxlr-like Strategic Performance Management) ---
model StrategicObjective {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  period      String
  status      String   @default("Active")
  priority    Int      @default(3)
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kpis        Kpi[]

  @@index([tenantId])
  @@map("strategic_objectives")
}

model Kpi {
  id           String   @id @default(uuid())
  tenantId     String
  objectiveId  String
  name         String
  unit         String
  targetValue  Float
  currentValue Float    @default(0)
  frequency    String   @default("Monthly")
  source       String   @default("MANUAL") // MANUAL or AUTOMATED
  sourceKey    String?

  organization       Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objective          StrategicObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  history            KpiHistory[]

  @@index([tenantId])
  @@index([objectiveId])
  @@map("kpis")
}

model KpiHistory {
  id        String   @id @default(uuid())
  kpiId     String
  value     Float
  timestamp DateTime @default(now())

  kpi       Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId])
  @@map("kpi_history")
}

model Certification {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  issuer      String
  issuedAt    DateTime @default(now())
  expiry      DateTime
  fileUrl     String?
  status      String   @default("Valid") // Valid, Warning, Expired
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("certifications")
}

model Permit {
  id          String   @id @default(uuid())
  tenantId    String
  driver      String
  category    String   // C, CE, D, B, ADR, etc.
  expiry      DateTime
  status      String   @default("Valid") // Valid, Warning, Expired
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("permits")
}

model Insurance {
  id          String   @id @default(uuid())
  tenantId    String
  company     String   // AXA, Allianz, etc.
  policy      String   // Police number
  coverageType String  @default("Tous Risques Flotte")
  vehicle     String?  // Camion X1, Flotte 42, etc.
  premium     Float?
  expiry      DateTime
  status      String   @default("Valid") // Valid, Warning, Expired
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("insurances")
}

// ============================================================================
// PONT D'ACCÈS & D'ABONNEMENT SAAS (SUBSCRIPTION & LICENSING BRIDGE)
// ============================================================================

model Plan {
  id               String         @id @default(cuid())
  code             String         @unique // FREE, STARTER, PRO, ENTERPRISE
  name             String
  description      String?
  priceMonthly     Float          @default(0.0)
  priceYearly      Float          @default(0.0)
  currency         String         @default("EUR")
  monthlyTokens    Int            @default(1000)
  maxAssets        Int            @default(5)
  maxUsers         Int            @default(2)
  has3dDigitalTwin Boolean        @default(false)
  hasZtnaHardware  Boolean        @default(false)
  hasRealtimeKafka Boolean        @default(false)
  hasEsgExport     Boolean        @default(false)
  features         String?        // JSON string list of feature bullet points
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  subscriptions    Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String       @id @default(cuid())
  tenantId           String
  planId             String
  status             String       @default("active") // trialing, active, past_due, canceled, unpaid, paused
  billingCycle       String       @default("monthly") // monthly, yearly
  provider           String       @default("paypal") // paypal, stripe, manual, license_key
  providerSubId      String?      @unique
  providerCustomerId String?
  currentPeriodStart DateTime     @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean      @default(false)
  canceledAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan         @relation(fields: [planId], references: [id])
  invoices           Invoice[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model LicenseKey {
  id                  String       @id @default(cuid())
  tenantId            String
  licenseKey          String       @unique // e.g. "SENS-PRO-8F9A-2B4C"
  tier                String       @default("PRO") // STARTER, PRO, ENTERPRISE
  hardwareFingerprint String?      // Hardware binding (Appliance HSM)
  validUntil          DateTime
  status              String       @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  activatedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("license_keys")
}

model Entitlement {
  id         String       @id @default(cuid())
  tenantId   String
  featureKey String       // e.g. "MODULE_COCKPIT_3D", "MODULE_OBSERVABILITY", "MODULE_COMPUTE"
  isGranted  Boolean      @default(true)
  quotaLimit Int?         // -1 for unlimited
  quotaUsed  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId])
  @@map("entitlements")
}

model AccessGateLog {
  id           String       @id @default(cuid())
  tenantId     String
  userId       String?
  requestedUri String       // e.g. "/cockpit", "/infrastructure", "/compute"
  action       String       // "GRANTED", "DENIED_UNPAID", "DENIED_UNAUTHENTICATED", "DENIED_QUOTA_EXCEEDED"
  reason       String?      // Details
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@map("access_gate_logs")
}

// ============================================================================
// UEM — UNIFIED ENDPOINT MANAGEMENT
// Gestion des postes de travail, commandes à distance, politiques & alertes DLP
// ============================================================================

model UemTerminal {
  id           String   @id @default(cuid())
  tenantId     String
  terminalId   String                          // Identifiant logique de l'agent (ex: "PC-CMR-001")
  hostname     String
  os           String   @default("Unknown")    // "Windows", "Linux", "macOS"
  osVersion    String?
  cpuCores     Int      @default(0)
  ramGb        Float    @default(0.0)
  diskGb       Float    @default(0.0)
  installedApps String  @default("[]")         // JSON array de strings
  lastIp       String?
  agentVersion String   @default("1.0.0")
  activeVersion Int     @default(1)            // Version de configuration actuellement appliquée par l'agent
  status       String   @default("UNKNOWN")    // ONLINE, OFFLINE, WARNING, CRITICAL, UNKNOWN
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, terminalId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, lastSeen])
  @@map("uem_terminals")
}

model UemCommandQueue {
  id           String    @id @default(cuid())
  tenantId     String
  terminalId   String                           // Correspond à UemTerminal.terminalId
  commandType  String                           // BLOCK_USB, INSTALL_APP, REBOOT, etc.
  payload      String    @default("{}")         // JSON string
  status       String    @default("PENDING")    // PENDING, EXECUTING, DONE, FAILED, TIMEOUT
  result       String?                          // Résultat retourné par l'agent
  createdBy    String?                          // userId de l'admin
  createdAt    DateTime  @default(now())
  executedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@index([terminalId, status])
  @@index([tenantId, createdAt])
  @@map("uem_command_queue")
}

model UemSecurityPolicy {
  id        String   @id @default(cuid())
  tenantId  String
  groupId   String                            // "default", "all", ou un terminalId spécifique
  policy    String   @default("{}")           // JSON SecurityPolicy
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, groupId])
  @@index([tenantId])
  @@map("uem_security_policies")
}

model UemAlert {
  id              String    @id @default(cuid())
  tenantId        String
  terminalId      String
  alertType       String                        // NON_COMPLIANT_SOFTWARE, USB_BLOCKED, AGENT_OFFLINE, etc.
  severity        String    @default("MEDIUM")  // LOW, MEDIUM, HIGH, CRITICAL
  message         String
  details         String?   @default("{}")      // JSON
  status          String    @default("OPEN")    // OPEN, ACKNOWLEDGED, RESOLVED
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, terminalId])
  @@map("uem_alerts")
}

// ─── Idempotence & Webhooks PayPal (Production-Ready) ────────────────────────
model ProcessedWebhookEvent {
  eventId     String   @id
  eventType   String
  processedAt DateTime @default(now())

  @@map("processed_webhook_events")
}

// ─── Transactional Outbox Pattern pour Kafka (Zéro perte de données) ──────────
model OutboxEvent {
  id          String    @id @default(cuid())
  topic       String
  payload     String
  key         String?
  status      String    @default("PENDING") // PENDING, PROCESSING, PUBLISHED, FAILED
  retryCount  Int       @default(0)
  maxRetries  Int       @default(5)
  lastError   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([topic])
  @@map("outbox_events")
}

// ─── Agrégation Temporelle & Rollups de Télémétrie (Data Lake Pyramidal) ──────
model TelemetryRollup {
  id          String   @id @default(cuid())
  tenantId    String
  sensorId    String
  interval    String   // "MINUTE", "HOUR", "DAY"
  timestamp   DateTime // Début de la période d'agrégation
  avgValue    Float
  maxValue    Float
  minValue    Float
  count       Int      // Nombre d'échantillons compressés
  createdAt   DateTime @default(now())

  @@index([tenantId, sensorId, interval, timestamp])
  @@index([interval, timestamp])
  @@map("telemetry_rollups")
}


